{
  "name": "@openrune/editor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@base-ui/react": "^1.4.1",
    "@openrune/cache": "*",
    "@openrune/engine": "*",
    "@openrune/gameval": "*",
    "@openrune/react": "*",
    "@openrune/sprite": "*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-fs": "2.5.0",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "^14.2.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.1.6"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "tauri:build:web": "npm run build && node scripts/prepare-tauri-frontend.js && node scripts/verify-tauri-frontend.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon public/tauri-icon-source.svg",
    "build:engine": "npm run build -w @openrune/engine",
    "dev:engine": "npm run dev -w @openrune/engine",
    "build:cache": "npm run build -w @openrune/cache",
    "dev:cache": "npm run dev -w @openrune/cache",
    "build:sprite": "npm run build -w @openrune/sprite",
    "dev:sprite": "npm run dev -w @openrune/sprite",
    "dump-map-tiles": "node scripts/dump-map-tiles.mjs",
    "check-cache-update": "node scripts/check-cache-update.mjs",
    "auto-dump-and-upload": "node scripts/auto-dump-and-upload.mjs",
    "dump-now": "node scripts/auto-dump-and-upload.mjs --manual",
    "check-dump-progress": "node scripts/check-dump-progress.mjs",
    "test": "echo \"No test runner configured\"",
    "lint": "prettier --write \"./**/*.{js,ts,jsx,tsx,css,md}\"",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "chrome >= 67",
      "edge >= 79",
      "firefox >= 68",
      "opera >= 54",
      "safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint-config-next": "^14.2.25",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "path": "^0.12.7",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.2.4"
  }
}
