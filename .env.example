# Copy this file to .env and fill in real values on the VPS. .env itself is gitignored —
# never commit your real secrets.
#
# Used by scripts/auto-dump-and-upload.mjs (the scheduled OSRS cache-update -> dump -> upload
# pipeline — see that file's header comment for the full flow and the crontab to install).

# Cloudflare R2 (S3-compatible) — from the bucket's "Manage API tokens" page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public base URL your CDN serves this bucket from. Not used to authenticate anything — kept
# here for reference/logging only.
R2_PUBLIC_BASE_URL=

# Optional overrides — defaults shown are used if omitted.
# MAP_VIEWER_BASE_URL=http://localhost:3000
# DUMPS_OUT_DIR=dumps
# CACHE_STATE_PATH=state/last-cache-id.json
