{
  "name": "@openrune/cache",
  "version": "0.1.0",
  "description": "Browser-safe RuneScape cache reader (legacy, dat, dat2 formats) — raw bytes in, decompressed/decrypted archive files out.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "dependencies": {
    "bzip2": "^0.1.1",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "tsup": "^8.3.5",
    "typescript": "^5.1.6"
  }
}
